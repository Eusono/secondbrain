# Gitignore for Second Brain Framework

# Local Code Overlays
personal/code/
work/code/

# Secrets Staging
local/
secrets/
*.enc
*.key
*.pem

# Python Cache & Environment
__pycache__/
*.pyc
.venv/
env/

# OS Artifacts
.DS_Store
Thumbs.db

# Agent Local Caches
.claude/
.gemini/
.agents/
.cursor/

# Explicitly track Second Brain context files (overrides global gitignore)
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!**/AGENTS.md
!**/CLAUDE.md
!**/GEMINI.md
